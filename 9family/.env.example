NODE_ENV=production
PORT=8096
BASE_PATH=/9family
# Vai trò và CSDL riêng trên 9ship-db (xem README). Đổi MAT_KHAU: app từ chối khởi động nếu còn mật khẩu mẫu.
DATABASE_URL=postgres://family:MAT_KHAU@9ship-db:5432/family
# Web Push: sinh bằng `npm run vapid` (cặp khóa tạo một lần, giữ cố định). Để trống = tắt đẩy.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@9app.tech
# Đọc ảnh thời khóa biểu bằng Gemini. Để trống = ẩn tính năng.
FAMILY_AI_KEY=
FAMILY_AI_MODEL=gemini-flash-latest
# (tùy chọn) FAMILY_AI_BASE=https://generativelanguage.googleapis.com   FAMILY_AI_RETRY_MS=1500
# Phân tích lời nói/ảnh thông báo trường và nhận dạng thời khóa biểu dùng chung khóa này; thiếu khóa thì ẩn phần AI, vẫn nhập tay được.
# Kết nối 9app Console (để trống = tắt). Secret >= 24 ký tự, trùng khai báo trong Console.
CONSOLE_API_KEY_ID=hub
CONSOLE_API_SECRET=
# Giới hạn
TRUSTED_PROXY_HOPS=1
FAMILY_AI_GLOBAL_PER_DAY=300
RATE_LIMIT_PER_MIN=6000
SESSION_LIMIT_PER_MIN=180
# (tùy chọn) ROUTE_LIMIT_FACTOR=1  MAX_FAMILIES_PER_IP_HOUR=10  SCHEDULER_EVERY_MS=20000
# (tùy chọn, chỉ để thử) FAMILY_PUSH_ALLOW_ANY=1 cho phép đẩy tới máy chủ đẩy lạ; KHÔNG bật trên máy chủ thật.

# ---- Tài khoản 9app dùng chung (9id) ----
# Địa chỉ 9id trong mạng docker (không đi qua internet). Container 9id nằm trên 9ship_internal và ops_tms-network như container này.
NINE_ID_URL=http://9id:8102/id
# Khóa HMAC của app này ở 9id: TRÙNG "family:<secret>" trong INTERNAL_KEYS của 9id. Secret >= 32 ký tự ngẫu nhiên. 9family là app thường (KHÔNG thuộc INTERNAL_DELEGATE_APPS).
NINE_ID_KEY_ID=family
NINE_ID_SECRET=
# Giao diện 9id trên cùng nguồn gốc (nginx: location /id/). Dùng cho nút Đăng nhập / Đăng ký / Lời mời.
NINE_ID_PUBLIC_PATH=/id/
# Đệm kết quả verify và đọc gia đình (ms). Tối đa 60000 theo spec 9id.
NINE_ID_CACHE_MS=60000
# (tùy chọn) NINE_ID_TIMEOUT_MS=5000 (chờ tối đa mỗi lần gọi 9id)  NINE_ID_BREAK_MS=1500 (9id vừa lỗi hạ tầng: trả 503 ngay trong ngần này ms)
# EDGE_SECRET (X-Edge-Secret) là cấu hình của 9id + nginx, 9family KHÔNG đọc biến này; 9family chỉ cần NINE_ID_URL trong mạng docker.
# CHỈ bật (=1) trong lúc cutover: cho phiên ẩn danh cũ (cookie fsid) XEM gia đình chưa được nhận về 9id. Chỉ đọc. Tắt sau khi chuyển xong.
LEGACY_SESSIONS=0

