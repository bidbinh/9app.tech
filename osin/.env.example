NODE_ENV=production
PORT=8103
# Chạy ở GỐC tên miền riêng osin.9app.tech (mặc định, khuyến nghị). Chế độ cũ dưới đường dẫn: BASE_PATH=/osin
BASE_PATH=
OSIN_PUBLIC_ORIGIN=https://osin.9app.tech
# Nơi các app ở (origin khác): liên kết sâu tới app phải là URL tuyệt đối
OSIN_APPS_ORIGIN=https://9app.tech
DATABASE_URL=postgres://osin:MAT_KHAU@9ship-db:5432/osin
# Bí mật máy chủ (>= 32 ký tự ngẫu nhiên): bảo vệ toàn vẹn hành động chờ xác nhận và băm khóa bộ đếm. Tạo bằng: openssl rand -hex 32
OSIN_SECRET=
# Danh tính: production bắt buộc 9id. Khóa trùng khai báo INTERNAL_KEYS (osin:SECRET) của dịch vụ 9id.
OSIN_IDENTITY=9id
OSIN_ID_URL=http://9id:8102/id
OSIN_ID_KEY_ID=osin
OSIN_ID_SECRET=
# Trang xin đăng nhập của 9id (luồng authorize?client=osin&redirect_uri=...&state=...)
#OSIN_ID_AUTHORIZE_URL=https://9app.tech/id/authorize
# Mô hình ngôn ngữ. Để trống khóa = chế độ không AI (chỉ lệnh đơn giản). Chỉ đặt khóa ở đây, không ghi vào tệp nào khác.
OSIN_AI_KEY=
#OSIN_AI_MODEL=gemini-flash-latest
# CHỈ đặt 1 khi vận hành đã kiểm tra gói API Gemini đang dùng KHÔNG dùng dữ liệu để huấn luyện; nếu không giao diện sẽ nói trung thực là chưa xác nhận
OSIN_AI_NO_TRAIN_CONFIRMED=
# Trần chi phí (mỗi người tối đa 4% trần toàn hệ; người mới < 24 giờ dùng 25% hạn mức)
#OSIN_USER_TOKENS_PER_DAY=120000
#OSIN_GLOBAL_TOKENS_PER_DAY=3000000
#OSIN_USER_MSGS_PER_DAY=150
#OSIN_CHAT_PER_MIN=12
#OSIN_CONFIRM_PER_HOUR=20
# Kết nối với 9app Console (để trống = tắt). Secret trùng với khai báo trong Console.
CONSOLE_API_KEY_ID=hub
CONSOLE_API_SECRET=
# 9id gọi để xóa dữ liệu khi người dùng xóa tài khoản (id:SECRET, ký giao thức OSIN1). Để trống = tắt.
OSIN_ERASE_KEYS=
# Số proxy tin cậy đứng trước app (nginx = 1)
TRUSTED_PROXY_HOPS=1
