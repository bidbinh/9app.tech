NODE_ENV=production
PORT=8101
BASE_PATH=/hire
DATABASE_URL=postgres://hire:MAT_KHAU@9ship-db:5432/hire
# Kết nối với 9app Console (để trống = tắt). Secret trùng với khai báo trong Console.
CONSOLE_API_KEY_ID=hub
CONSOLE_API_SECRET=
# Đăng nhập 9id (tài khoản 9app dùng chung). Để trống = tắt, app chạy ẩn danh. Bí mật >= 32 ký tự, trùng khóa 'hire' trong INTERNAL_KEYS của 9id.
NINE_ID_URL=http://9id:8102/id
NINE_ID_KEY_ID=hire
NINE_ID_SECRET=
NINE_ID_PUBLIC_PATH=/id/
