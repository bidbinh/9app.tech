# Sao chép thành .env rồi điền. Xem docs/SETUP-CHECKLIST.md để biết cần đăng ký những gì.
NODE_ENV=production
PORT=8099
BASE_PATH=/9ship
DB_PASSWORD=doi-mat-khau-dai-ngau-nhien

# Khóa ký link nhãn và OTP: chuỗi ngẫu nhiên dài (openssl rand -hex 32)
SIGN_SECRET=
# Quản trị: mã quản trị + bí mật TOTP (base32, dùng với Google Authenticator / Authy)
ADMIN_TOKEN=
ADMIN_TOTP_SECRET=

# Hãng/đơn vị tổng hợp thật: danh sách tệp adapter (xem docs/ADAPTER-CONTRACT.md). Đặt MOCK_CARRIERS=false khi đã có adapter thật.
CARRIER_MODULES=
MOCK_CARRIERS=false

# Gửi OTP: console (chỉ thử nghiệm) hoặc webhook (relay SMS/Zalo của bạn)
OTP_PROVIDER=webhook
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=

# Nhận tiền nạp (VietQR) và webhook báo tiền về
BANK_BIN=970436
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
BANK_WEBHOOK_SECRET=

# Tùy chọn
# WALLET_OVERDRAFT_CAP=50000
# BUFFER_PCT=20
# BUFFER_MIN=3000
# BUFFER_TTL_HOURS=336
# PRICE_DRIFT_PCT=5
# CLAIM_WINDOW_DAYS=30
