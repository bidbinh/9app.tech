# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env.
NODE_ENV=production
PORT=8110
BASE_PATH=/stay

# PostgreSQL (CSDL "stay" và vai trò riêng trong container 9ship-db). Production bắt buộc đặt, không được còn giá trị mẫu.
DATABASE_URL=postgres://stay:DOI_MAT_KHAU_MANH@9ship-db:5432/stay

# 9id: địa chỉ nội bộ qua mạng docker, khóa app và bí mật ký (cùng cặp với INTERNAL_KEYS="stay:SECRET" ở 9id, SECRET >= 32 ký tự)
NINE_ID_URL=http://9id:8102/id
NINE_ID_KEY=stay
NINE_ID_SECRET=

# nginx đặt X-Edge-Secret cùng giá trị này trên mọi yêu cầu tới /stay/ (>= 32 ký tự); thiếu hoặc sai thì 9stay từ chối
EDGE_SECRET=

# Số proxy tin cậy phía trước (nginx đặt X-Forwarded-For = $remote_addr thì để 1)
TRUSTED_PROXY_HOPS=1

# Giới hạn tần suất mỗi phút (tùy chọn)
# RATE_LIMIT_PER_MIN=1200
# REDEEM_LIMIT_PER_MIN=10

# Bí mật dùng chung với nhà cung cấp webhook ngân hàng (chữ ký HMAC-SHA256 của thân yêu cầu, hoặc "Authorization: Apikey <bí mật>"). >= 32 ký tự.
# Để trống thì webhook từ chối mọi yêu cầu.
BANK_WEBHOOK_SECRET=
