NODE_ENV=production
PORT=8098
BASE_PATH=/interview
# Khóa Gemini (chỉ ở máy chủ). Để trống = tắt phần AI; luyện tập, CV, thư xin việc vẫn dùng được.
INTERVIEW_AI_KEY=
# INTERVIEW_AI_MODEL=gemini-flash-latest
# Đứng sau nginx thì để 1. Khi đó nginx PHẢI đặt: proxy_set_header X-Forwarded-For $remote_addr; (ghi đè, không dùng $proxy_add_x_forwarded_for). Máy chủ lấy phần tử CUỐI của header này.
TRUST_PROXY=1
# Giới hạn (mặc định ghi sẵn): mỗi IP mỗi phút / mỗi ngày, mỗi phiên mỗi phút, toàn hệ thống mỗi ngày
# INTERVIEW_IP_PER_MIN=8
# INTERVIEW_IP_PER_DAY=60
# INTERVIEW_SESSION_PER_MIN=6
# INTERVIEW_GLOBAL_PER_DAY=3000
