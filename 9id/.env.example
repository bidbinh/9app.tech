NODE_ENV=production
PORT=8102
BASE_PATH=/id
DATABASE_URL=postgres://id:MAT_KHAU@9ship-db:5432/id

# Bí mật để băm số điện thoại (lời mời) và mã OTP. Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" (64 ký tự hex)
# Đặt một lần rồi GIỮ NGUYÊN. Muốn đổi: xem README mục "Xoay PHONE_PEPPER" (đặt PHONE_PEPPER_OLD trong 14 ngày).
PHONE_PEPPER=DOI_CHUOI_NAY_THANH_BI_MAT_NGAU_NHIEN
# PHONE_PEPPER_OLD=

# Bí mật dùng chung với nginx: nginx đặt header X-Edge-Secret cùng giá trị cho mọi yêu cầu /id/ từ trình duyệt.
# Không có header đúng thì 9id từ chối yêu cầu trình duyệt và không tin X-Forwarded-For.
EDGE_SECRET=DOI_CHUOI_NAY_THANH_BI_MAT_NGAU_NHIEN

# Cổng gửi OTP: production chỉ chấp nhận esms (Zalo ZNS trước, SMS brandname sau)
OTP_PROVIDER=esms
ESMS_API_KEY=
ESMS_SECRET=
ESMS_BRANDNAME=
ESMS_ZALO_OA=
ESMS_ZALO_TEMP=
# ESMS_CHANNELS=zalo,sms
# Trần SMS toàn hệ mỗi ngày (chống đốt tiền); OTP_DAILY_RESERVED là phần dành riêng cho đặt lại mật khẩu của tài khoản đã có
OTP_DAILY_GLOBAL=2000
OTP_DAILY_RESERVED=400
# Độ khó proof-of-work trước khi gửi SMS (17 bit = khoảng nửa giây trên điện thoại)
POW_BITS=16

# Nhập tài khoản 9Sport (để trống = tắt). Địa chỉ nội bộ của 9Sport, ví dụ http://k77htk:8000
SSO_9SPORT_URL=

# Khóa cho các app gọi API nội bộ: id:secret,id:secret (secret >= 32 ký tự, mỗi app một khóa riêng)
INTERNAL_KEYS=family:DOI_CHUOI_NAY_0000000000000000000000000000
# App nào được xin 4 số cuối điện thoại (phoneLast4) qua verify
INTERNAL_LAST4_APPS=
# App được dùng `as` không kèm token phiên của người dùng (bị ghi nhật ký và giới hạn thấp hơn). Mặc định để trống: mọi app phải kèm token.
INTERNAL_DELEGATE_APPS=
# App được nhập gia đình hiện có (POST /internal/v1/import/families)
INTERNAL_IMPORT_APPS=

# App ở tên miền con riêng đăng nhập bằng mã dùng một lần: client=redirect_uri[,redirect_uri];client2=... (khớp chính xác, https, không wildcard).
# Mỗi client phải có khóa cùng tên trong INTERNAL_KEYS.
OAUTH_CLIENTS=

# Kết nối với 9app Console (để trống = tắt). Secret trùng với khai báo trong Console.
CONSOLE_API_KEY_ID=hub
CONSOLE_API_SECRET=

# Số proxy tin cậy đứng trước app (nginx = 1; Cloudflare + nginx = 2)
TRUSTED_PROXY_HOPS=1
